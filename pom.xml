<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.stonetpa</groupId>
    <artifactId>stonetpa</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>StoneTPA</name>
    <description>Full-featured teleport request (TPA) system with a player settings GUI, configurable
        countdown/arrival notifications (chat, action bar, boss bar or title) and particle effects for Paper
        servers.
    </description>

    <properties>
        <!-- Ported to Java 25 / Paper API 26.2 -->
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API is provided by the server at runtime -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <!-- Ported to Java 25 / Paper API 26.2 (pinned stable build, not a version range) -->
            <version>26.2.build.124-stable</version>
            <scope>provided</scope>
        </dependency>

        <!--
          Test-only dependencies. NOTE: a full MockBukkit-simulated server was
          deliberately NOT used here - MockBukkit-v1.21 transitively requires
          io.papermc.paper:paper-api:1.21.1-R0.1-SNAPSHOT, which only exists
          on repo.papermc.io (Paper never publishes SNAPSHOT builds to Maven
          Central) and is unreachable in the sandbox this was built in. Player
          interactions are instead tested with plain Mockito mocks, which only
          need Maven Central.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.24.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.24.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Ported to Java 25 / Paper API 26.2 -->
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
        </plugins>
    </build>
</project>
